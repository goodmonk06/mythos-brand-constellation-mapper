# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/mythos_constellation?schema=public"

# Application
NODE_ENV="development"
PORT="3000"

# Optional: AI/LLM Integration
# OPENAI_API_KEY="sk-..."
# ANTHROPIC_API_KEY="sk-ant-..."

# Optional: Webhook Integration
# WEBHOOK_URL="https://your-service.com/webhooks/constellation"

# Optional: S3 Storage (for file uploads)
# S3_BUCKET="your-bucket-name"
# S3_REGION="us-east-1"
# S3_ACCESS_KEY_ID="your-access-key"
# S3_SECRET_ACCESS_KEY="your-secret-key"

# Optional: Slack Integration
# SLACK_WEBHOOK_URL="https://hooks.slack.com/services/..."
